# Copy to .env.local and fill in as needed.

# Auth is optional and OFF by default; the app runs fully without it.
NEXT_PUBLIC_AUTH_ENABLED=false

# Optional: override where story data is written (defaults to ./story-data)
# STORY_DATA_PATH=

# Required only when NEXT_PUBLIC_AUTH_ENABLED=true:
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
